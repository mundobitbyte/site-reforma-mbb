      "consultar:16-estrutura": [
        {
          "type": "index",
          "name": "historico_status_pedido",
          "sql": "CREATE INDEX historico_status_pedido ON historico_status(pedido_id, id)"
        },
        {
          "type": "table",
          "name": "cupom",
          "sql": "CREATE TABLE cupom (\n    codigo TEXT PRIMARY KEY CHECK (length(trim(codigo)) > 0),\n    percentual INTEGER NOT NULL\n        CHECK (typeof(percentual) = 'integer' AND percentual BETWEEN 1 AND 100),\n    minimo_centavos INTEGER NOT NULL\n        CHECK (typeof(minimo_centavos) = 'integer' AND minimo_centavos >= 0),\n    validade TEXT NOT NULL,\n    utilizado INTEGER NOT NULL DEFAULT 0 CHECK (utilizado IN (0, 1))\n)"
        },
        {
          "type": "table",
          "name": "historico_status",
          "sql": "CREATE TABLE historico_status (\n    id INTEGER PRIMARY KEY,\n    pedido_id INTEGER NOT NULL REFERENCES pedido(id),\n    estado_anterior TEXT NOT NULL,\n    estado_novo TEXT NOT NULL,\n    alterado_em TEXT NOT NULL DEFAULT (datetime('now')),\n    CHECK (\n        (estado_anterior = 'Novo' AND estado_novo = 'Confirmado') OR\n        (estado_anterior = 'Confirmado' AND estado_novo = 'Em preparação') OR\n        (estado_anterior = 'Em preparação' AND estado_novo = 'Pronto') OR\n        (estado_anterior = 'Pronto' AND estado_novo = 'Entregue')\n    )\n)"
        },
        {
          "type": "table",
          "name": "item_pedido",
          "sql": "CREATE TABLE item_pedido (\n    pedido_id INTEGER NOT NULL REFERENCES pedido(id),\n    produto_id INTEGER NOT NULL REFERENCES produto(id),\n    quantidade INTEGER NOT NULL\n        CHECK (typeof(quantidade) = 'integer' AND quantidade BETWEEN 1 AND 10),\n    preco_unitario_centavos INTEGER NOT NULL\n        CHECK (typeof(preco_unitario_centavos) = 'integer' AND preco_unitario_centavos >= 0),\n    PRIMARY KEY (pedido_id, produto_id)\n)"
        },
        {
          "type": "table",
          "name": "pedido",
          "sql": "CREATE TABLE pedido (\n    id INTEGER PRIMARY KEY,\n    criado_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    status TEXT NOT NULL DEFAULT 'Novo'\n        CHECK (status IN ('Novo', 'Confirmado', 'Em preparação', 'Pronto', 'Entregue'))\n, cupom_codigo TEXT REFERENCES cupom(codigo), desconto_centavos INTEGER NOT NULL DEFAULT 0\n    CHECK (typeof(desconto_centavos) = 'integer' AND desconto_centavos >= 0))"
        },
        {
          "type": "table",
          "name": "produto",
          "sql": "CREATE TABLE produto (\n    id INTEGER PRIMARY KEY,\n    nome TEXT NOT NULL CHECK (length(trim(nome)) > 0),\n    preco_centavos INTEGER NOT NULL\n        CHECK (typeof(preco_centavos) = 'integer' AND preco_centavos >= 0),\n    estoque INTEGER NOT NULL\n        CHECK (typeof(estoque) = 'integer' AND estoque >= 0)\n)"
        },
        {
          "type": "view",
          "name": "resumo_pedido",
          "sql": "CREATE VIEW resumo_pedido AS\nSELECT p.id, p.criado_em, p.status, p.cupom_codigo, p.desconto_centavos,\n       COALESCE(SUM(i.quantidade * i.preco_unitario_centavos), 0) AS subtotal_centavos\nFROM pedido AS p\nLEFT JOIN item_pedido AS i ON i.pedido_id = p.id\nGROUP BY p.id, p.criado_em, p.status, p.cupom_codigo, p.desconto_centavos"
        }
      ],
